<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>OTP Verification</title>
</head>

<body style="
      margin: 0;
      padding: 0;
      background-color: #f4f6f9;
      font-family: &quot;Segoe UI&quot;, Arial, sans-serif;
    ">
  <table width="100%" cellpadding="0" cellspacing="0" style="background-color: #f4f6f9; padding: 40px 0">
    <tr>
      <td align="center">
        <table width="480" cellpadding="0" cellspacing="0" style="
              background-color: #ffffff;
              border-radius: 12px;
              overflow: hidden;
              box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
            ">
          <!-- Header -->
          <tr>
            <td align="center" style="background-color: #1a73e8; padding: 36px 40px">
              <h1 style="
                    margin: 0;
                    color: #ffffff;
                    font-size: 22px;
                    letter-spacing: 0.5px;
                  ">
                PH Healthcare
              </h1>
              <p style="margin: 6px 0 0; color: #d0e8ff; font-size: 13px">
                Secure Verification
              </p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="padding: 40px 40px 24px">
              <h2 style="margin: 0 0 8px; color: #1a1a2e; font-size: 20px">
                Hello, <%= name %> 👋
              </h2>
              <p style="
                    margin: 0 0 28px;
                    color: #555;
                    font-size: 15px;
                    line-height: 1.6;
                  ">
                Use the OTP below to complete your verification. Do not share
                this code with anyone.
              </p>

              <!-- OTP Box -->
              <div style="text-align: center; margin: 0 0 28px">
                <div style="
                      display: inline-block;
                      background-color: #f0f5ff;
                      border: 2px dashed #1a73e8;
                      border-radius: 10px;
                      padding: 20px 48px;
                    ">
                  <span style="
                        font-size: 38px;
                        font-weight: 700;
                        letter-spacing: 10px;
                        color: #1a73e8;
                      ">
                    <%= otp %>
                  </span>
                </div>
              </div>

              <!-- Expiry notice -->
              <div style="
                    background-color: #fff8e1;
                    border-left: 4px solid #f9a825;
                    border-radius: 6px;
                    padding: 12px 16px;
                    margin-bottom: 28px;
                  ">
                <p style="margin: 0; color: #7a5800; font-size: 13px">
                  ⏳ This OTP will expire in <strong>2 minutes</strong>.
                </p>
              </div>

              <p style="
                    margin: 0;
                    color: #888;
                    font-size: 13px;
                    line-height: 1.6;
                  ">
                If you did not request this, please ignore this email or
                contact our support team immediately.
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td style="
                  background-color: #f9fafc;
                  padding: 20px 40px;
                  border-top: 1px solid #ebebeb;
                  text-align: center;
                ">
              <p style="margin: 0; color: #aaa; font-size: 12px">
                &copy; <%= new Date().getFullYear() %> PH Healthcare. All
                  rights reserved.
              </p>
            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>
</body>

</html>